# ---------------------------------------------------------------------------
# ReTeam environment variables. Copy to .env.local (Next.js) / .env (scripts).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled connection string from Neon console,
# or `neon connection-string production`). Required by the app and by
# `npm run db:migrate`, `npm run db:seed`, `npm run token:test`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Public base URL of this deployment. Used to build installation URLs and the
# resource links returned by the installation API. No trailing slash.
APP_URL=http://localhost:3000

# Admin login password (single owner login). Use a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign the admin session cookie and to hash client IPs in
# access logs. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-me-to-a-random-48-byte-secret
